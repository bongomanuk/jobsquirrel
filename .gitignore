# secrets and machine-specific files
.env
*.secret
*.token
credentials.json
client_secret*.json
token.json
gmail_token.json
accounts.json

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*~
.~lock.*

# python
__pycache__/
*.pyc
.venv/
venv/

# rendered scratch output (keep curated documents/ in git)
/tmp/
*.tmp

.venv-graphrag/

# generated / sensitive
state/logs/*.png
state/logs/*.jpg
kb/sources/contracts/

# runtime logs are machine-local noise: keep them on disk, out of git/diffs
state/logs/
# derived reconcile cache (message bodies; re-fetched on demand)
state/gmail_cache.json
state/gmail_cache.json.gz
# compressed copies of old logs and regenerable index caches (tools/storage.py)
kb/archives/
# generated tool indexes and incremental-index working dirs
.codegraph/
kb/graphrag/update_output/
# packaged artifacts
job-agent.zip

# transient queue-run control files (created/recreated by run_queue.sh)
state/queue.stop
state/queue.tokenfail
state/queue.tokenfail.lock
state/gates/
jobsquirrel/

# runtime agent permission policy (machine-local)
config/agent-permissions.json

# one-time email send receipts (human approvals)
state/send-receipts/
