# GraphRAG credentials, read from the environment by settings.yaml.
# Copy to kb/graphrag/.env (bash tools/setup_kb.sh does it), or put the values
# in the secrets store and let it materialise this file.
#
# Never commit the real .env. kb/graphrag/.gitignore already excludes it.

# Key for the completion model endpoint in settings.yaml.
GRAPHRAG_API_KEY=

# Key for the embedding endpoint. A local server usually accepts anything.
GRAPHRAG_EMBEDDING_KEY=

# Optional: model ids if you prefer them here rather than in settings.yaml.
GRAPHRAG_LLM_MODEL=
GRAPHRAG_EMBEDDING_MODEL=
