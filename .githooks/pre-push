#!/usr/bin/env bash
# Refuse to push private material into the public build.
set -u
root=$(git rev-parse --show-toplevel); cd "$root" || exit 1
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_sha:-}" ] || continue
  case "${remote_sha:-}" in
    0000000000000000000000000000000000000000|"") range="origin/main..$local_sha" ;;
    *) range="$remote_sha..$local_sha" ;;
  esac
  python3 tools/private_guard.py --range "$range" || status=1
done
exit "$status"
